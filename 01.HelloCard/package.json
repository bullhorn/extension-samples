{
  "name": "bullhorn-extension-samples",
  "version": "1.0.0",
  "description": "Bullhorn ATS - Sample Extensions.",
  "author": "Bullhorn",
  "license": "MIT",
  "scripts": {
    "analyze": "npm run clean && npm run build -- --stats-json && webpack-bundle-analyzer ./dist/stats.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "clean": "rimraf ./dist/",
    "deploy": "npm run build:prod && firebase deploy --only hosting",
    "lint": "ng lint",
    "ng": "ng",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "start-qa": "ng serve --configuration development --ssl false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@bullhorn/bullhorn-icons": "^2.18.0",
    "@bullhorn/bullhorn-types": "^1.89.0",
    "ace-builds": "1.4.5",
    "angular2-text-mask": "9.0.0",
    "brace": "0.11.1",
    "classlist.js": "1.1.20150312",
    "compute-hmean": "1.0.0",
    "core-js": "^3.39.1",
    "date-fns": "2.30.0",
    "firebase": "^10.14.0",
    "novo-elements": "^10.16.0",
    "post-robot": "^8.0.30",
    "roboto-fontface": "0.10.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/language-service": "^19.0.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@types/node": "^18.11.0",
    "@typescript-eslint/eslint-plugin": "5.48.0",
    "@typescript-eslint/parser": "5.48.0",
    "eslint": "^8.17.0",
    "ts-node": "^10.1.0",
    "typescript": "~5.6.0",
    "webpack-bundle-analyzer": "3.3.2"
  }
